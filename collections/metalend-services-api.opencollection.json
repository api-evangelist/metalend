{
  "opencollection": "1.0.0",
  "info": {
    "name": "MetaLend Rebalancing AI Agent Guide Services API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Services directory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.metalend.tech/v1/services"
          },
          "docs": "Returns MetaLend API services directory with docs links and endpoint summaries."
        }
      ]
    }
  ],
  "bundled": true
}